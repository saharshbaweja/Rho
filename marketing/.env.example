# Public canonical site origin, e.g. your actual deployed HTTPS domain.
NEXT_PUBLIC_SITE_URL=
# Server-only HTTPS endpoint that accepts validated demo requests.
# Never use NEXT_PUBLIC_ for these values. Missing configuration returns 503.
AEROS_DEMO_WEBHOOK_URL=
AEROS_DEMO_WEBHOOK_TOKEN=

# Default contact flow prepares an email to contact@aeros.com.
# Set to webhook only after configuring and validating server delivery.
NEXT_PUBLIC_DEMO_REQUEST_DELIVERY=email
